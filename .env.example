APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Emails allowed to edit platform settings (model provider + API keys) at
# /dashboard/settings. Comma-separated. Empty = the first registered account.
PLATFORM_ADMINS=

APP_LOCALE=ka
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cortexgrid
DB_USERNAME=postgres
DB_PASSWORD=
# Tip: for local peer auth you can instead set DB_HOST=/var/run/postgresql (no password).

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- LLM providers ---
# Which backend answers questions: groq | openrouter | nvidia | cerebras | anthropic.
# Everything except `anthropic` is an OpenAI-compatible endpoint, so switching is
# a matter of setting the provider's key below — no code change.
LLM_PROVIDER=groq
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

GROQ_API_KEY=
# Used for query rewriting and reranking (small, latency-sensitive calls).
GROQ_MODEL=qwen/qwen3.8-27b
# Used for answering, when LLM_PROVIDER=groq.
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# --- Other OpenAI-compatible backends -------------------------------------
# Set LLM_PROVIDER to one of these and fill in its key; no code change needed.
# Model ids per tier (fast / standard / max) are in config/services.php.

# OpenRouter — widest model choice, many ":free" ids.
# Free tier is roughly 20 req/min and 50 req/day; a one-time $10 raises it to ~1000/day.
# Note: not every ":free" model supports tool calling, which admin agents need.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free

# NVIDIA NIM (build.nvidia.com) — free credits, OpenAI-compatible.
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Cerebras — very fast inference, free tier.
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b

# Embedding dimension — must match GEMINI_EMBEDDING_MODEL (text-embedding-004 = 768).
EMBEDDING_DIM=768

# --- Google OAuth (Socialite) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
